# ---------- API (apps/api) ----------
NODE_ENV=development
PORT=4000
# Postgres connection string. Leave empty in development to use the built-in PGlite database
# (stored in apps/api/.data). Production must set this (managed Postgres, Mumbai region).
DATABASE_URL=
# Secret used to sign admin sign-in tokens: a long random string (at least 32 characters) in production.
JWT_SECRET=change-me-change-me-change-me-change-me
# Browser origins allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:3000
# First super admin, created on API start if no admin exists. Remove after first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional: purge the CDN cache after publishing schemes (Cloudflare).
CF_ZONE_ID=
CF_API_TOKEN=
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# Optional: a Slack/Discord/Teams webhook that is told when the API hits an unexpected error.
ERROR_WEBHOOK_URL=
# Set to false on every API instance except one (the hourly statistics job).
RUN_JOBS=true

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
